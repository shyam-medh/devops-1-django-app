# Force GitHub Linguist to include infrastructure code in language statistics
*.tf linguist-language=HCL linguist-detectable=true
*.tfvars linguist-language=HCL linguist-detectable=true
*.hcl linguist-language=HCL linguist-detectable=true
*.yaml linguist-language=YAML linguist-detectable=true
*.yml linguist-language=YAML linguist-detectable=true
*.json linguist-language=JSON linguist-detectable=true
*.md linguist-language=Markdown linguist-detectable=true
*.sh linguist-language=Shell linguist-detectable=true
Jenkinsfile linguist-language=Groovy linguist-detectable=true
Dockerfile linguist-language=Dockerfile linguist-detectable=true
